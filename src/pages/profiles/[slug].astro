---
import SocialLink from "../../components/SocialLink.astro";
import { socialIcons } from "../../lib/social-links";
import Avatar from "../../components/Avatar";
import Layout from "../../layouts/Layout.astro";
import {
  people,
  localsForPerson,
  memberships,
  pageFor,
  hrefFor,
  isActive,
  isCurrentTsc,
  isCurrentAmbassador,
  transitionName,
  cardHrefFor,
} from "../../lib/directory";
import shared from "../../styles/shared.module.css";
import styles from "./profile.module.css";
import starCardStyles from "../../components/star-card.module.css";
export function getStaticPaths() {
  return Object.entries(people).map(([slug, person]) => ({
    params: { slug },
    props: { slug, person },
  }));
}
const { slug, person } = Astro.props;
const appearances = memberships.filter((m) => m.person === slug);
const groups = [...new Set(appearances.map((m) => m.page))].filter(
  (page) => !page.startsWith("stars/") && !page.startsWith("speakers/"),
);
const localGroups = localsForPerson(slug);
const projects = [
  ...new Set(appearances.flatMap((m) => m.maintainerProjects ?? [])),
];
const articles = appearances.flatMap((m) => (m.article ? [m.article] : []));
const talks = appearances.filter((m) => m.talk);
const interests = [...new Set(appearances.flatMap((m) => m.interests ?? []))];
const bio = appearances.find((m) => m.about);
const anchor = person.githubUsername ?? slug;
const cardImage = appearances.findLast((m) => m.image)?.image;
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`;
const links = [
  ...new Map(
    appearances
      .flatMap((m) => m.links ?? [])
      .filter((l) => /^https?:\/\//.test(l.url))
      .map((l) => [l.url, l]),
  ).values(),
];

const profileLinks = [
  ...(person.githubUsername
    ? [{ label: "GitHub", url: `https://github.com/${person.githubUsername}` }]
    : []),
  ...links,
]
  .filter((link, index, all) => {
    const normalize = (value: string) => {
      const url = new URL(value);
      const host = url.hostname.replace(/^www\./, "").replace(/^x\.com$/, "twitter.com");
      for (const key of [...url.searchParams.keys()])
        if (key.startsWith("utm_")) url.searchParams.delete(key);
      return `${host}${url.pathname.replace(/\/$/, "")}${url.search}`.toLowerCase();
    };
    return (
      all.findIndex(
        (candidate) => normalize(candidate.url) === normalize(link.url),
      ) === index
    );
  })
  .map((link) => {
    const url = new URL(link.url);
    const host = url.hostname.replace(/^www\./, "");
    const parts = url.pathname.split("/").filter(Boolean);
    const platform =
      (
        {
          "github.com": "github",
          "facebook.com": "facebook",
          "instagram.com": "instagram",
          "linkedin.com": "linkedin",
          "x.com": "twitter",
          "twitter.com": "twitter",
          "bsky.app": "bluesky",
          "threads.net": "threads",
          "threads.com": "threads",
          "youtube.com": "youtube",
          "youtu.be": "youtube",
        } as Record<string, string>
      )[host] ?? link.label.toLowerCase();
    const handle = parts.at(-1)?.replace(/^@/, "");
    const text =
      platform === "linkedin"
        ? person.name
        : ["github", "twitter", "bluesky", "threads"].includes(platform) &&
            handle
          ? `@${handle}`
          : platform === "youtube" && parts[0]?.startsWith("@")
            ? parts[0]
            : platform === "website"
              ? host
              : link.label;
    return { ...link, text, platform, host, icon: socialIcons[platform] ?? "globe" };
  })
  .sort((a, b) => {
    const rank = (platform: string) =>
      platform === "github" ? 0 : platform === "website" ? 2 : 1;
    return (
      rank(a.platform) - rank(b.platform) ||
      (a.platform === "website" ? a.host : a.platform).localeCompare(
        b.platform === "website" ? b.host : b.platform,
      ) ||
      a.url.localeCompare(b.url)
    );
  });
---

<Layout
  title={`${person.name} · People of GraphQL`}
  description={`Discover ${person.name}'s participation in the GraphQL community.`}
  image={cardImage}
>
  <article class:list={[shared.wrap, styles.profile]}>
    <header class={styles.header}>
      <Avatar
        client:load
        name={person.name}
        className={[
          styles.avatar,
          isCurrentTsc(slug)
            ? styles.gold
            : isCurrentAmbassador(slug)
              ? styles.ambassador
              : "",
        ].join(" ")}
        src={person.avatarUrl}
        style={{
          viewTransitionName: transitionName(slug),
        }}
      />
      <div>
        <h1>{person.name}</h1>
        {profileLinks.length > 0 && (
          <ul
            class={styles.links}
            aria-label={`${person.name}'s online profiles`}
          >
            {profileLinks.map((link) => (
              <li>
                <SocialLink
                  url={link.url}
                  label={link.label}
                  text={link.text}
                  icon={link.icon}
                  appearance="profile"
                />
              </li>
            ))}
          </ul>
        )}
        {person.location && <p class={styles.location}>{person.location}</p>}
        {interests.length > 0 && !bio && (
          <p class={styles.location}>Ask me about {interests.join(", ")}.</p>
        )}
        {bio && (
          <figure class={styles.bioQuote}>
            <blockquote class={styles.bio}>
              <span class={styles.quoteMark} aria-hidden="true">“</span>
              {bio.about}
              <span class={styles.quoteMark} aria-hidden="true">”</span>
            </blockquote>
            <figcaption class={styles.bioAttribution}>
              <em>— taken from {person.name.trim().split(/\s+/)[0]}'s GraphQLConf{bio.aboutYear ? ` ${bio.aboutYear}` : ""} speaker profile</em>
            </figcaption>
          </figure>
        )}
      </div>
    </header>
    {(groups.length > 0 || localGroups.length > 0 || projects.length > 0) && (
      <section class={styles.section} aria-labelledby="community-title">
        <h2 id="community-title">Around the community</h2>
        <ul class={styles.appearances}>
          {groups.map((page) => {
            const ms = appearances.filter((m) => m.page === page);
            const active = ms.some((m) => isActive(m));
            const isAmbassador = page === "ambassadors";
            const isAttendance =
              page.startsWith("wg/") && ms[0].count !== undefined;
            return (
              <li>
                <a href={`${hrefFor(page)}#${anchor}`}>
                  <span>
                    {isAmbassador
                      ? active
                        ? "GraphQL Ambassador"
                        : "GraphQL Ambassador Emeritus"
                      : pageFor(page).title}
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>
                {isAmbassador ? (
                  <p>
                    {active
                      ? "Current Ambassador"
                      : `Term: ${ms[0].term ?? "2025-2026"}`}
                  </p>
                ) : isAttendance ? (
                  <p>
                    {active
                      ? `${ms[0].label} member${ms[0].lastActive ? ` · last attended in ${ms[0].lastActive.slice(0, 4)}` : ""}`
                      : `Used to attend ${ms[0].label}`}
                  </p>
                ) : (
                  page !== "wg/tsc" && (
                    <p>
                      {!active ? "Previously active · " : ""}
                      {ms.some((m) => m.chair)
                        ? "Chair"
                        : ms.some((m) => m.emeriti)
                          ? "Emeritus"
                          : ms[0].label}
                    </p>
                  )
                )}
                {page !== "wg/tsc" && ms[0].affiliation && (
                  <p>
                    {ms[0].affiliation}
                    {ms[0].emeriti ? " · affiliation during term" : ""}
                  </p>
                )}
                {ms[0].termStart && (
                  <p>
                    Term: {ms[0].termStart} – {ms[0].termEnd}
                  </p>
                )}
              </li>
            );
          })}
          {localGroups.map((local) => (
            <li>
              <a href={local.url} target="_blank" rel="noopener noreferrer">
                <span>{local.name}</span>
                <span aria-hidden="true">↗</span>
              </a>
              <p>Organizer</p>
            </li>
          ))}
          {projects.map((project) => (
            <li>
              <h3 class={styles.tileTitle}>{project}</h3>
              <p>Maintainer</p>
            </li>
          ))}
        </ul>
      </section>
    )}
    {appearances.some((m) => m.image) && (
      <section class={styles.section} aria-labelledby="cards-title">
        <h2 id="cards-title">Stars contribution cards</h2>
        <div class={styles.cards}>
          {appearances
            .filter((m) => m.image)
            .map((m) => (
              <a href={cardHrefFor(m.image!)}>
                <img
                  src={m.image}
                  class={starCardStyles.card}
                  alt={`${person.name} · ${m.label}`}
                  loading="lazy"
                />
              </a>
            ))}
        </div>
        <p class={styles.share}>
          <SocialLink
            url={linkedInShareUrl}
            label="Share on LinkedIn"
            text="Share on LinkedIn"
            icon={socialIcons.linkedin}
            appearance="profile"
          />
        </p>
      </section>
    )}
    {articles.length > 0 && (
      <section class={styles.section} aria-labelledby="stories-title">
        <h2 id="stories-title">Stories</h2>
        {articles.map((a) => (
          <a href={a.href} class={styles.story}>
            {a.image && (
              <img src={a.image} alt={a.imageAlt ?? ""} loading="lazy" />
            )}
            <div>
              <h3>{a.title}</h3>
              <p>{a.description}</p>
              <span>Read the story ↗</span>
            </div>
          </a>
        ))}
      </section>
    )}
    {talks.length > 0 && (
      <section class={styles.section} aria-labelledby="talks-title">
        <h2 id="talks-title">Talks & appearances</h2>
        {talks.map((m) => (
          <article id={`talk-${m.talk!.id}`} class={styles.talk}>
            <a class={styles.event} href={`${hrefFor(m.page)}#${anchor}`}>
              {pageFor(m.page).title} ↗
            </a>
            <h3>{m.talk!.title}</h3>
            {m.talk!.videoId && (
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${m.talk!.videoId}`}
                title={m.talk!.title}
                loading="lazy"
                allow="encrypted-media; picture-in-picture; fullscreen"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              />
            )}
          </article>
        ))}
      </section>
    )}
  </article>
</Layout>
