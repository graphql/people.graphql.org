---
import styles from "./article.module.css";
import StorySocialLinks from "../../components/StorySocialLinks.astro";
import SocialLink from "../../components/SocialLink.astro";
import CopyLink from "../../components/CopyLink.astro";
import { socialIcons } from "../../lib/social-links";
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { people } from "../../lib/directory";
export async function getStaticPaths() {
  return (await getCollection("stories")).map((story) => ({
    params: { id: story.id },
    props: { story },
  }));
}
const { story } = Astro.props;
const links = story.data.links ?? [];
const firstName = story.data.name.trim().split(/\s+/)[0];
const storyUrl = new URL(`/stories/${story.id}/`, Astro.site).href;
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(storyUrl)}`;
const shareText =
  story.data.shareText ??
  `Read “${story.data.title}” with ${story.data.name} on People of GraphQL.`;
const shareSuffix = `\n\n${storyUrl}\n\n@graphql.org #GraphQL`;
// Keep the complete URL and tags within Bluesky's 300-character limit.
const textBudget = 300 - Array.from(shareSuffix).length;
const characters = Array.from(shareText);
const blueskyText =
  (characters.length > textBudget
    ? characters
        .slice(0, textBudget - 1)
        .join("")
        .trimEnd() + "…"
    : shareText) + shareSuffix;
const blueskyShareUrl = `https://bsky.app/intent/compose?text=${encodeURIComponent(blueskyText)}`;
const profile = Object.entries(people).find(
  ([, person]) =>
    story.data.github &&
    person.githubUsername?.toLowerCase() === story.data.github.toLowerCase(),
);
const { Content } = await render(story);
const formatDate = (date: Date) => {
  const day = date.getUTCDate();
  const suffix =
    day >= 11 && day <= 13
      ? "th"
      : (({ 1: "st", 2: "nd", 3: "rd" } as Record<number, string>)[day % 10] ??
        "th");
  const monthAndYear = date.toLocaleDateString("en-GB", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
  return `${day}${suffix} ${monthAndYear}`;
};
---

<Layout
  title={`${story.data.title} · People of GraphQL`}
  description={story.data.description}
  image={story.data.hero?.src}
>
  <article class={styles.storyFeature}>
    <a class={styles.storyBack} href="/stories/">
      ← All stories
    </a>
    <header class={styles.storyFeatureHeader}>
      <h1>{story.data.title}</h1>
      <div class={styles.storyIntroduction}>
        <div>
          <p class={styles.storyDeck}>{story.data.description}</p>
        </div>
        {links.length > 0 && (
          <aside
            class={styles.storyPersonDetails}
            aria-label="About the contributor"
          >
            <p class={styles.storyEyebrow}>Find {firstName} online</p>
            <StorySocialLinks links={links} />
          </aside>
        )}
      </div>
    </header>
    {story.data.hero && (
      <figure class:list={[styles.storyPhoto, styles.storyHero]}>
        <div class={styles.storyHeroImage}>
          <img
            src={story.data.hero.src}
            alt={story.data.hero.alt}
            width="1800"
            height="1200"
            fetchpriority="high"
          />
          <span class={styles.storyHeroStripes} aria-hidden="true"></span>
        </div>
        <figcaption>{story.data.hero.caption}</figcaption>
      </figure>
    )}
    <div class={styles.storyReadingLayout}>
      <aside
        class={styles.storyProjectNote}
        aria-label={`About ${story.data.name}`}
      >
        <p class={styles.storyPerson}>{story.data.name}</p>
        {story.data.sidebar && (
          <p class={styles.storyPersonRole}>{story.data.sidebar.role}</p>
        )}
        <div class={styles.storyProjectCopy}>
          {story.data.sidebar && <p>{story.data.sidebar.introduction}</p>}
          {profile && (
            <a href={`/profiles/${profile[0]}/`}>
              Explore {firstName}’s profile →
            </a>
          )}
        </div>
        <nav class={styles.storyShare} aria-label="Share this story">
          <h2 class={styles.storyEyebrow}>Share this story</h2>
          <ul>
            <li>
              <SocialLink
                url={linkedInShareUrl}
                label="Share this story on LinkedIn"
                text="Share on LinkedIn"
                icon={socialIcons.linkedin}
                appearance="profile"
              />
            </li>
            <li>
              <SocialLink
                url={blueskyShareUrl}
                label="Share this story on Bluesky"
                text="Share on Bluesky"
                icon={socialIcons.bluesky}
                appearance="profile"
              />
            </li>
            <li>
              <CopyLink url={storyUrl} />
            </li>
          </ul>
        </nav>
      </aside>
      <Content />
      <p class={styles.storyCredit}>
        Interview with {story.data.name} recorded on{" "}
        <time datetime={story.data.recordedAt.toISOString().slice(0, 10)}>
          {formatDate(story.data.recordedAt)}
        </time>{" "}
        and published by {story.data.interviewer} on{" "}
        <time datetime={story.data.publishedAt.toISOString().slice(0, 10)}>
          {formatDate(story.data.publishedAt)}
        </time>
        .
      </p>
      {(story.data.relatedLinks || links.length > 0) && (
        <section class={styles.storyMoreLinks} aria-label="Explore further">
          {story.data.relatedLinks && (
            <div>
              <h2>{story.data.relatedLinks.title}</h2>
              <ul class={styles.storyContextLinks}>
                {story.data.relatedLinks.items.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.title}
                    </a>
                    <p>{link.description}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {links.length > 0 && (
            <aside
              class:list={[styles.storyPersonDetails, styles.storyMoreSocial]}
              aria-label={`Find ${firstName} online`}
            >
              <h2>Find {firstName} online</h2>
              <StorySocialLinks links={links} />
            </aside>
          )}
        </section>
      )}
      <a class:list={[styles.storyBack, styles.storyEnd]} href="/stories/">
        Meet more people of GraphQL →
      </a>
    </div>
  </article>
</Layout>
